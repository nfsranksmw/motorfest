const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const membersContainer = document.getElementById('members-container');

async function cargarMiembrosDinamicos() {
    if (!membersContainer) return;

    try {
        const querySnapshot = await getDocs(collection(db, "members"));
        
        if (querySnapshot.empty) return;

        // Limpiamos el contenido estático de prueba y cargamos los reales de Firestore
        membersContainer.innerHTML = "";

        querySnapshot.forEach((doc) => {
            const member = doc.data();
            
            const card = document.createElement('div');
            card.className = "member-box"; // O la clase CSS que use tu diseño
            card.style.cssText = "background: #121214; border: 1px solid #222; border-radius: 12px; overflow: hidden; text-align: center; margin-bottom: 20px;";
            
            card.innerHTML = `
                <div style="height: 120px; overflow: hidden; background: #000;">
                    <img src="${member.photoUrl}" alt="${member.pilotName}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.8;">
                </div>
                <div style="padding: 20px;">
                    <h3 style="color: #fff; font-family: 'Orbitron', sans-serif; font-size: 1.1rem; margin-bottom: 5px;">[BSKR] ${member.pilotName}</h3>
                    <p style="color: #ffe600; font-size: 0.85rem; margin-bottom: 5px;">Piloto Oficial BSKR</p>
                    <p style="color: #9ca3af; font-size: 0.75rem;">${member.email}</p>
                </div>
            `;
            
            membersContainer.appendChild(card);
        });

    } catch (error) {
        console.error("Error al cargar el directorio de miembros: ", error);
    }
}

document.addEventListener("DOMContentLoaded", () => {
    cargarMiembrosDinamicos();
});
