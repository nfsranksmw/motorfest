import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { getFirestore, collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

const firebaseConfig = {
    apiKey: "AIzaSyBPvGd0mCaql2yMeKK3UogRBDj3Ig9EYOI",
    authDomain: "bskrmostorfest.firebaseapp.com",
    databaseURL: "https://bskrmostorfest-default-rtdb.firebaseio.com",
    projectId: "bskrmostorfest",
    storageBucket: "bskrmostorfest.firebasestorage.app",
    messagingSenderId: "662332371404",
    appId: "1:662332371404:web:c70d8219c6e74fafffed69",
    measurementId: "G-WHH6X6227Z"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

// Apuntamos al ID exacto que tienes en tu HTML: "members-grid"
const membersGrid = document.getElementById('members-grid');

async function cargarMiembrosDinamicos() {
    if (!membersGrid) return;

    try {
        const querySnapshot = await getDocs(collection(db, "members"));
        
        membersGrid.innerHTML = "";

        if (querySnapshot.empty) {
            membersGrid.innerHTML = `<p style="text-align: center; color: #6b7280; grid-column: 1 / -1;">No hay miembros registrados todavía.</p>`;
            return;
        }

        querySnapshot.forEach((doc) => {
            const member = doc.data();
            
            const card = document.createElement('div');
            card.style.cssText = "background: #111; border: 1px solid #333; border-radius: 12px; overflow: hidden; text-align: center; padding-bottom: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.5);";
            
            card.innerHTML = `
                <div style="height: 120px; overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center;">
                    <img src="${member.photoUrl}" alt="${member.pilotName}" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid #ffe600; margin-top: 20px;">
                </div>
                <div style="padding: 20px 15px 10px 15px;">
                    <h3 style="color: #fff; font-family: 'Orbitron', sans-serif; font-size: 1.1rem; margin-bottom: 5px;">[BSKR] ${member.pilotName}</h3>
                    <p style="color: #ffe600; font-size: 0.85rem; font-weight: bold; margin-bottom: 8px;">Piloto Oficial / Motorfest</p>
                    <p style="color: #9ca3af; font-size: 0.75rem; word-break: break-all;">${member.email}</p>
                </div>
            `;
            
            membersGrid.appendChild(card);
        });

    } catch (error) {
        console.error("Error al cargar los miembros: ", error);
        membersGrid.innerHTML = `<p style="text-align: center; color: #ff0055; grid-column: 1 / -1;">Error al cargar el directorio.</p>`;
    }
}

document.addEventListener("DOMContentLoaded", () => {
    cargarMiembrosDinamicos();
});
